# Backend LLM API Configuration (OpenAI-compatible)
# Support: OpenAI, DeepSeek, OpenRouter, Groq, Ollama, vLLM, etc.

PORT=3000

# OpenAI API Key (or DeepSeek, OpenRouter, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Base URL for OpenAI-compatible endpoint
# - OpenAI default: https://api.openai.com/v1
# - DeepSeek: https://api.deepseek.com
# - OpenRouter: https://openrouter.ai/api/v1
# - Ollama local: http://localhost:11434/v1
# - Groq: https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Default model name
# Examples: gpt-4o-mini, gpt-4o, deepseek-chat, llama-3.3-70b-versatile, qwen2.5:7b
OPENAI_MODEL=gpt-4o-mini

# Translation Concurrency (Number of chunks processed in parallel)
TRANSLATION_CONCURRENCY=3

# Max tokens per chunk for smart splitting
MAX_CHUNK_SIZE=2500
