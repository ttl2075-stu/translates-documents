PORT=3000
SITE_URL=http://localhost:3000

# CSDL MySQL (kết nối qua mysql2 pool)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your-mysql-password
DB_NAME=translate_saas

# JWT Secret Key dùng để ký token xác thực tài khoản
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2026

# Google OAuth 2.0 & Google Sign-In (Lấy từ Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Tích hợp cổng thanh toán SePay Webhook
# Secret Key lấy từ Dashboard SePay -> Webhooks -> Secret Key (xác thực HMAC-SHA256)
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret-key

# Cấu hình tài khoản ngân hàng thụ hưởng (Hiển thị mã QR VietQR)
BANK_NAME=MBBank
BANK_ACCOUNT=0988888888
BANK_ACCOUNT_NAME=NGUYEN VAN A

# API Key của nhà cung cấp LLM (OpenAI hoặc DeepSeek)
OPENAI_API_KEY=sk-your-api-key-here

# Base URL API (Hỗ trợ DeepSeek, OpenAI hoặc bên thứ ba)
# DeepSeek: https://api.deepseek.com
# OpenAI:   https://api.openai.com/v1
OPENAI_BASE_URL=https://api.deepseek.com

# Model AI (Khuyến nghị dùng deepseek-chat hoặc gpt-4o-mini để có tốc độ stream nhanh nhất)
OPENAI_MODEL=deepseek-chat

# Số luồng dịch song song đồng thời (Concurrency)
TRANSLATION_CONCURRENCY=3

# Kích thước tối đa mỗi phân đoạn (ký tự)
MAX_CHUNK_SIZE=1200

# Cấu hình Mail Server (SMTP) để tự động gửi file dịch & mã OTP reset mật khẩu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="AI Document Translator <noreply@yourdomain.com>"
